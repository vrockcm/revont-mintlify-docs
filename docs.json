{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Revont",
  "description": "AI Call Assistant for Sales — real-time guidance, automatic summaries, and CRM sync for every call.",
  "colors": {
    "primary": "#ffffff",
    "light": "#ffffff",
    "dark": "#ffffff"
  },
  "favicon": {
    "light": "/images/Revont_RevontBlack.svg",
    "dark": "/images/Revont_RevontWhite.svg"
  },
  "icons": {
    "library": "fontawesome"
  },
  "styling": {
    "eyebrows": "section"
  },
  "contextual": {
    "options": ["copy", "view", "assistant"]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Getting Started",
        "href": "/getting-started",
        "icon": "rocket"
      },
      {
        "tab": "Documentation",
        "icon": "book-open",
        "href": "/user-guide/introduction"
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api/overview",
              "api/authentication"
            ]
          },
          {
            "group": "Endpoints",
            "pages": [
              "api/calls",
              "api/summaries",
              "api/contacts",
              "api/webhooks"
            ]
          }
        ]
      },
      {
        "tab": "Changelog",
        "pages": [
          "product-updates"
        ],
        "hidden": true
      }
    ]
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Go to App",
      "href": "https://app.revont.ai"
    }
  },
  "footer": {
    "socials": {
      "instagram": "https://www.instagram.com/revont.ai"
    }
  },
  "logo": {
    "light": "/images/Revont_RevontLogoBlack.png",
    "dark": "/images/Revont_RevontLogoWhite.png",
    "href": "https://revont.ai"
  },
  "background": {
    "color": {
      "light": "#121212",
      "dark": "#121212"
    }
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "fonts": {
    "family": "Inter"
  }
}
